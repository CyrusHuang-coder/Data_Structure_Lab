{
  "buildCommand": "npm run build",
  "outputDirectory": "upstream/algorithm-visualizer/dist",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "upstream/algorithm-visualizer/study-server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "regions": [
    "iad1"
  ]
}
